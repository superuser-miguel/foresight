# Rust
/target
crates/*/target
Cargo.lock.orig

# Flatpak
/build-dir
/.flatpak-builder
/repo
/builddir-flatpak.log
/.flatpak-builder-*

# Flatpak release flow — build outputs, not sources. The bundle is an artifact
# of the GitHub Release, and repo-release is a regenerable OSTree repo; neither
# belongs in git. (build-dir-release self-ignores via flatpak-builder.)
/repo-release
/build-dir-release
/Foresight.flatpak

# Scratch tree for scripts/publish-repo.sh. Lives in-project rather than /tmp
# because flatpak-builder refuses a state dir on a different filesystem, and
# /tmp is tmpfs here.
/.publish-tmp.*

# Meson
/_build
/builddir

# Editor / OS
*.swp
*~
.DS_Store
