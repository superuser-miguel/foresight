#: crates/foresight/src/capabilities.rs:189
msgid "--backup (-b)"
msgstr ""

#: crates/foresight/src/capabilities.rs:190
msgid "Keep backups of files that get replaced or deleted."
msgstr ""

#: crates/foresight/src/capabilities.rs:193
msgid "--partial"
msgstr ""

#: crates/foresight/src/capabilities.rs:194
msgid "Keep partially transferred files so a re-run can resume them."
msgstr ""

#: crates/foresight/src/capabilities.rs:197
msgid "--filter / merge files"
msgstr ""

#: crates/foresight/src/capabilities.rs:199
msgid ""
"rsync's fuller filter syntax: rules read from a file, and per-directory "
"merge rules. Plain include and exclude rules are a control — see Filter "
"rules above."
msgstr ""

